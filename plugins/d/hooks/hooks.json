{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/warn-noncanonical-cwd.ps1"],
            "timeout": 15,
            "statusMessage": "Checking the launch path casing"
          },
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/report-local-link-form.ps1"],
            "timeout": 10,
            "statusMessage": "Choosing the local file link form"
          },
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/report-worktree-slot.ps1"],
            "timeout": 10,
            "statusMessage": "Checking for a worktree slot"
          },
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/guard-ado-pat.ps1"],
            "timeout": 10,
            "statusMessage": "Checking for a PAT in the monitor-devops settings"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/block-inplace-shell-edits.ps1"],
            "timeout": 10,
            "statusMessage": "Checking for in-place shell edits"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*push*)",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/gate-git-push.ps1"],
            "timeout": 10,
            "statusMessage": "Checking the push"
          },
          {
            "type": "command",
            "if": "PowerShell(*git*push*)",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/gate-git-push.ps1"],
            "timeout": 10,
            "statusMessage": "Checking the push"
          },
          {
            "type": "command",
            "if": "Bash(* pr create*)",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/gate-git-push.ps1"],
            "timeout": 10,
            "statusMessage": "Checking the pull request"
          },
          {
            "type": "command",
            "if": "PowerShell(* pr create*)",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/gate-git-push.ps1"],
            "timeout": 10,
            "statusMessage": "Checking the pull request"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *commit*)",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/check-commit-message.ps1"],
            "timeout": 10,
            "statusMessage": "Checking the commit message"
          },
          {
            "type": "command",
            "if": "PowerShell(git *commit*)",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/check-commit-message.ps1"],
            "timeout": 10,
            "statusMessage": "Checking the commit message"
          },
          {
            "type": "command",
            "if": "Bash(git *commit*)",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/repair-line-endings-before-commit.ps1"],
            "timeout": 10,
            "statusMessage": "Repairing line endings"
          },
          {
            "type": "command",
            "if": "PowerShell(git *commit*)",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/repair-line-endings-before-commit.ps1"],
            "timeout": 10,
            "statusMessage": "Repairing line endings"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "if": "Write(//**/monitor-devops.local.md)",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/guard-ado-pat.ps1"],
            "timeout": 10,
            "statusMessage": "Checking for a PAT"
          },
          {
            "type": "command",
            "if": "Edit(//**/monitor-devops.local.md)",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/guard-ado-pat.ps1"],
            "timeout": 10,
            "statusMessage": "Checking for a PAT"
          }
        ]
      },
      {
        "matcher": "mcp__.*(comment|pull_request).*",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/gate-external-post.ps1"],
            "timeout": 10,
            "statusMessage": "Checking the external post"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/format-cs-on-edit.ps1"],
            "timeout": 30,
            "statusMessage": "Applying .editorconfig formatting"
          },
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/flag-added-comments-on-edit.ps1"],
            "timeout": 10,
            "statusMessage": "Checking added comments"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "if": "Write(~/.claude/projects/**/memory/*.md)",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/record-feedback-memory.ps1"],
            "timeout": 10,
            "statusMessage": "Adding feedback to the backlog"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/format-summary-on-stop.ps1"],
            "timeout": 5,
            "statusMessage": "Summarizing formatting time"
          }
        ]
      }
    ]
  }
}
