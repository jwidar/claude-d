{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/warn-noncanonical-cwd.ps1"],
            "timeout": 15,
            "statusMessage": "Checking the launch path casing"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/block-inplace-shell-edits.ps1"],
            "timeout": 10,
            "statusMessage": "Checking for in-place shell edits"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/format-cs-on-edit.ps1"],
            "timeout": 30,
            "statusMessage": "Applying .editorconfig formatting"
          },
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/flag-added-comments-on-edit.ps1"],
            "timeout": 10,
            "statusMessage": "Checking added comments"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-File", "${CLAUDE_PLUGIN_ROOT}/hooks/format-summary-on-stop.ps1"],
            "timeout": 5,
            "statusMessage": "Summarizing formatting time"
          }
        ]
      }
    ]
  }
}
